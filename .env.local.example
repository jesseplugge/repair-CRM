# Copy to .env.local and fill in from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — required only for "E-mail" buttons (receipts, invoices, signed intake) to work.
# Get a free API key at resend.com, verify a sending domain, then set:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
